Checks: >
    bugprone-*,
    -bugprone-easily-swappable-parameters,
    -bugprone-suspicious-stringview-data-usage,
    -bugprone-derived-method-shadowing-base-method,
    -bugprone-signed-bitwise

    modernize-*,
    -modernize-use-trailing-return-type,
    -modernize-use-integer-sign-comparison,
    -modernize-use-nodiscard,
    -modernize-avoid-c-arrays,

    misc-*,
    -misc-const-correctness,
    -misc-use-anonymous-namespace,
    -misc-new-delete-overloads,
    -misc-non-private-member-variables-in-classes,
    -misc-multiple-inheritance,
    -misc-explicit-constructor,
    -misc-static-assert, # good check actually, but too much false reports. maybe will be reenabled in future

    readability-*,
    -readability-redundant-member-init,
    -readability-identifier-length,
    -readability-uppercase-literal-suffix,
    -readability-static-accessed-through-instance,
    -readability-make-member-function-const,
    -readability-avoid-return-with-void-value,
    -readability-named-parameter,
    -readability-magic-numbers,
    -readability-math-missing-parentheses,

    performance-*,
    portability-*,
    concurrency-*,
    clang-analyzer-*,
    clang-diagnostic-*,


# Turn all the warnings from the checks above into errors.
WarningsAsErrors: "*"

CheckOptions:
    bugprone-exception-escape.CheckNothrowFunctions:        false
    readability-function-cognitive-complexity.IgnoreMacros: true
    misc-include-cleaner.MissingIncludes:                   false

    readability-operators-representation.BinaryOperators:   "&&;&=;&;|;&;~;!;!=;||;|=;^;^="
    readability-operators-representation.OverloadedOperators:   "&&;&=;&;|;&;~;!;!=;||;|=;^;^="



    readability-identifier-naming.ConstantCase:             UPPER_CASE
    readability-identifier-naming.ConstantMemberCase:       lower_case
    readability-identifier-naming.LocalConstantCase:        lower_case
    readability-identifier-naming.NamespaceCase:            lower_case
    readability-identifier-naming.ConstexprVariableCase:    UPPER_CASE
    readability-identifier-naming.ClassCase:                CamelCase
    readability-identifier-naming.StructCase:               CamelCase
    readability-identifier-naming.TemplateParameterCase:    UPPER_CASE
    readability-identifier-naming.FunctionCase:             lower_case
    readability-identifier-naming.VariableCase:             lower_case
    readability-identifier-naming.PrivateMemberPrefix:      m_
    readability-identifier-naming.ProtectedMemberPrefix:    m_
    readability-identifier-naming.MacroDefinitionCase:      UPPER_CASE
    readability-identifier-naming.LocalVariableCase:        lower_case
    readability-identifier-naming.PublicMemberCase:         lower_case
    readability-identifier-naming.PrivateMemberCase:        lower_case
    readability-identifier-naming.ProtectedMemberCase:      lower_case
